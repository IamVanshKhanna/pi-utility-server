---
import Base from '../layouts/Base.astro';
---

<Base title="Home">
  <section class="relative mb-20 pt-8 pb-4">
    <div class="gradient-blob absolute -top-10 -left-10 w-72 h-72 rounded-full pointer-events-none -z-10"></div>
    <p class="text-sm font-semibold text-accent mb-3 tracking-wide uppercase">Melbourne, Australia &middot; Open to Grad Roles</p>
    <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-text leading-tight">
      Hi, I'm Vansh. <br />
      <span class="text-brand">I build things</span> and write down <span class="text-accent">why</span>.
    </h1>
    <p class="text-lg text-text-muted max-w-xl mb-8">
      Graduate Software Engineer with an Application Security minor. I ship real projects —
      an AI code-review agent, a self-hosted homelab I rebuilt and then deliberately cut back down,
      an ops-analytics dashboard — and I document the decisions, not just the outcomes.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="https://github.com/iamvanshkhanna" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-cta text-white font-semibold hover:bg-cta-hover transition-colors">
        See my projects &rarr;
      </a>
      <a href="https://linkedin.com/in/iamvanshkhanna" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-full border border-surface-light font-semibold hover:bg-surface-light/40 transition-colors">
        About me
      </a>
    </div>
  </section>

  <section class="mb-20 reveal">
    <h2 class="font-display text-2xl font-semibold mb-6 text-brand">Featured work</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/projects" class="card-lift block border border-surface-light rounded-2xl p-6 bg-surface-light/20">
        <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-2">AI &middot; Pre-launch MVP</p>
        <h3 class="font-display font-semibold text-lg mb-2">devpilot</h3>
        <p class="text-sm text-text-muted">AI code-review agent that installs as a GitHub App — Next.js, FastAPI, PostgreSQL, Redis.</p>
      </a>
      <a href="/homelab" class="card-lift block border border-surface-light rounded-2xl p-6 bg-surface-light/20">
        <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-2">Infra &middot; Case Study</p>
        <h3 class="font-display font-semibold text-lg mb-2">The Homelab Rebuild</h3>
        <p class="text-sm text-text-muted">Built it big, then retired half of it on purpose. 9 ADRs, real decisions, real reversals.</p>
      </a>
      <a href="/projects" class="card-lift block border border-surface-light rounded-2xl p-6 bg-surface-light/20">
        <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-2">Data &middot; Python/pandas</p>
        <h3 class="font-display font-semibold text-lg mb-2">Digital Operations Analytics</h3>
        <p class="text-sm text-text-muted">Multi-source ops dashboard — support, infra, and hiring data, cleaned and correlated.</p>
      </a>
    </div>
  </section>

  <section class="reveal">
    <h2 class="font-display text-2xl font-semibold mb-4 text-brand">What I actually know</h2>
    <div class="flex flex-wrap gap-2">
      {['Python', 'TypeScript', 'C++', 'Docker', 'Linux', 'Tailscale/Headscale', 'Astro', 'CI/CD', 'Penetration Testing', 'AI/LLM tooling'].map((skill) => (
        <span class="text-sm px-3 py-1.5 rounded-full bg-brand/10 text-brand-dark font-medium">{skill}</span>
      ))}
    </div>
  </section>
</Base>

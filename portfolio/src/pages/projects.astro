---
import Base from '../layouts/Base.astro';

const projects = [
  {
    title: 'devpilot',
    tag: 'AI &middot; Pre-launch MVP',
    description: 'AI code-review agent that installs as a GitHub App. Reviews PRs, catches bugs, enforces conventions, learns team patterns.',
    tech: ['Next.js', 'FastAPI', 'PostgreSQL', 'Redis'],
    href: 'https://github.com/iamvanshkhanna/devpilot',
    big: true,
  },
  {
    title: 'The Homelab Rebuild',
    tag: 'Infrastructure &middot; Case Study',
    description: 'Self-hosted homelab: built a two-node stack, then deliberately retired half of it once the RAM cost wasn\'t justified. 9 ADRs, documented reversals, not just wins.',
    tech: ['Docker', 'Headscale', 'Gitea CI', 'Astro'],
    href: '/homelab',
    internal: true,
    big: true,
  },
  {
    title: 'Digital Operations Analytics',
    tag: 'Data &middot; Python/pandas',
    description: 'Multi-source ops dashboard — ingests, cleans, and correlates support tickets, infrastructure health, and hiring data across three domains.',
    tech: ['Python', 'pandas', 'Data Pipelines'],
    href: 'https://github.com/iamvanshkhanna/digital-operations-analytics',
  },
  {
    title: 'vansh-local-ai-stack',
    tag: 'AI &middot; Local Inference',
    description: 'Python CLI tooling for running LLMs locally via Ollama — no cloud dependency, no per-token cost.',
    tech: ['Python', 'Ollama', 'CLI'],
    href: 'https://github.com/iamvanshkhanna/vansh-local-ai-stack',
  },
];
---

<Base title="Projects">
  <h1 class="font-display text-4xl font-bold mb-4 text-brand-dark">Projects</h1>
  <p class="text-lg text-text-muted mb-12 max-w-2xl">
    Real repos, real commits. Click through — nothing here is a stub.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <a
        href={project.href}
        target={project.internal ? '_self' : '_blank'}
        rel={project.internal ? '' : 'noopener'}
        class:list={['card-lift block border border-surface-light rounded-2xl p-6 bg-surface-light/20', project.big && 'md:col-span-2']}
      >
        <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-2" set:html={project.tag}></p>
        <h2 class="font-display text-xl font-semibold mb-2">{project.title}</h2>
        <p class="text-sm text-text-muted mb-4">{project.description}</p>
        <div class="flex flex-wrap gap-2">
          {project.tech.map((t) => (
            <span class="text-xs px-2 py-1 rounded-full bg-brand/15 text-brand-dark font-medium">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Base>

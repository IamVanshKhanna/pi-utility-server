---
import Base from '../layouts/Base.astro';

const services = [
  { name: 'Vaultwarden', path: 'http://100.64.0.1:8081', desc: 'Password manager', color: '#a78bfa' },
  { name: 'Gitea', path: 'http://100.64.0.1:8087', desc: 'Self-hosted Git & CI/CD', color: '#34d399' },
  { name: 'Headscale', path: 'http://100.64.0.1:8086/health', desc: 'Mesh control plane', color: '#818cf8' },
  { name: 'Pi-hole', path: 'http://100.64.0.1:8053/admin', desc: 'DNS ad-blocking', color: '#f87171' },
  { name: 'Uptime Kuma', path: 'http://100.64.0.1:8082', desc: 'Live service status — the real source of truth', color: '#fb923c' },
  { name: 'Netdata', path: 'http://100.64.0.1:19999', desc: 'Real-time system + container metrics', color: '#e879f9' },
  { name: 'Portfolio', path: 'http://100.64.0.1:8090', desc: 'This site', color: '#38bdf8' },
];
---

<Base title="Hub">
  <h1 class="text-4xl font-bold mb-2 text-brand-light">Hub</h1>
  <p class="text-lg text-text-muted mb-12 max-w-2xl">
    Direct links to every live service — all reachable over the Headscale mesh, no reverse proxy in front.
    For actual live up/down status, <a href="http://100.64.0.1:8082" class="text-brand-dark hover:underline">Uptime Kuma</a>
    is the real source of truth, not this page.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {services.map((svc) => (
      <a href={svc.path} target="_blank" rel="noopener" class="block border border-surface-light rounded-lg p-4 bg-surface-light/20 hover:bg-surface-light/40 transition-colors">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background:${svc.color}`}></span>
          <h3 class="font-semibold text-text">{svc.name}</h3>
        </div>
        <p class="text-sm text-text-muted">{svc.desc}</p>
        <p class="text-xs text-text-muted mt-1 font-mono break-all">{svc.path}</p>
      </a>
    ))}
  </div>
</Base>

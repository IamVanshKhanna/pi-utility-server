---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Multi-node homelab: Pi + Windows, orchestrated with Docker Compose, mesh via Tailscale' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | homelab-ops-mesh</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <nav class="border-b border-surface-light bg-surface/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-brand-light hover:text-brand transition-colors">
          homelab-ops-mesh
        </a>
        <div class="flex gap-6 text-sm">
          <a href="/" class:list={["hover:text-brand-light transition-colors", currentPath === "/" && "text-brand-light font-semibold"]}>Home</a>
          <a href="/projects" class:list={["hover:text-brand-light transition-colors", currentPath === "/projects" && "text-brand-light font-semibold"]}>Projects</a>
          <a href="/architecture" class:list={["hover:text-brand-light transition-colors", currentPath === "/architecture" && "text-brand-light font-semibold"]}>Architecture</a>
          <a href="/about" class:list={["hover:text-brand-light transition-colors", currentPath === "/about" && "text-brand-light font-semibold"]}>About</a>
        </div>
      </div>
    </nav>

    <main class="flex-1 max-w-5xl mx-auto w-full px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-surface-light py-8 text-center text-text-muted text-sm">
      <p>homelab-ops-mesh &mdash; Raspberry Pi 4B + Windows &mdash; Tailscale Mesh</p>
    </footer>
  </body>
</html>

# 
# homelab-prod - Environment Variables
# Copy this file: cp .env.example .env
# Then fill in every value before deploying.
# NEVER commit your .env file - it is in .gitignore
#
# Live values live in /home/vansh/.secrets/pi-utility-server.env on autobot-1.
# Deploy with: docker compose --env-file <env file> -f <stack>/docker-compose.yml up -d
# or run pi/scripts/update.sh which resolves the env file automatically.
#

# --- GENERAL --------------------------------------------------
TZ=Australia/Melbourne
PUID=1000
PGID=1000
BACKUP_DIR=/mnt/nas/backup
RESTIC_CACHE_DIR=/mnt/nas/02. shared/02. Pi_ServiceData/restic-cache

# --- DOMAIN ---------------------------------------------------
# Used by vaultwarden for generated URLs. Mesh address for direct service
# access (see ADR-007).
DOMAIN=http://100.84.60.109:8081

# --- PIHOLE ---------------------------------------------------
PIHOLE_WEBPASSWORD=change-me

# --- VAULTWARDEN ----------------------------------------------
# Generate token with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=change-me

# --- SAMBA ----------------------------------------------------
SAMBA_PASSWORD=change-me

# --- HEADSCALE (v1.6+) ----------------------------------------
HEADSCALE_API_KEY=change-me

# --- BESZEL (monitoring v3) -----------------------------------
BESZEL_EMAIL=admin@example.com
BESZEL_PASSWORD=change-me
BESZEL_UNIVERSAL_TOKEN=change-me
BESZEL_HUB_KEY=change-me

# --- GITEA (push auth, dual-remote workflow) ------------------
GITEA_PUSH_TOKEN=change-me

# --- ALERTING ------------------------------------------------
# Telegram bot token (from @BotFather), your chat ID, and admin chat IDs
# (comma-separated) for tinybot. Get chat_id: msg @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
ADMIN_CHAT_IDS=change-me

# --- BACKUP (Restic) -----------------------------------------
RESTIC_PASSWORD=change-me
RESTIC_REPOSITORY=change-me
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
# Optional B2 backend:
# B2_ACCOUNT_ID=change-me
# B2_ACCOUNT_KEY=change-me

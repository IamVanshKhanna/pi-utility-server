[Unit]
Description=Homelab Secrets Rotation Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vansh
Group=vansh
WorkingDirectory=/home/vansh/homelab-ops-mesh/pi
ExecStart=/home/vansh/homelab-ops-mesh/pi/scripts/secrets-rotation.sh
Environment=HOME=/home/vansh

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/vansh/homelab-ops-mesh

[Install]
WantedBy=multi-user.target

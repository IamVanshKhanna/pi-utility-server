# users_database.yml — Authelia user database
# Copy this template: cp users_database.yml.template users_database.yml
# Generate password hash: docker run authelia/authelia authelia hash-password 'yourpassword'
# NEVER commit the real users_database.yml (it is in .gitignore)
users:
  your_username:
    displayname: "Your Name"
    password: "$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_HASH_FROM_authelia_hash-password"
    email: your.email@example.com
    groups:
      - admins
      - users

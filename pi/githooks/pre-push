#!/usr/bin/env bash
# pre-push gate: refuse to push to the 'github' remote unless gitea CI
# (workflow "Deploy Homelab") for the pushed commit is green.
# Install with: pi/githooks/install.sh
set -uo pipefail

remote="${1:-}"
[[ "$remote" == "github" ]] || exit 0

GITEA_API='http://100.84.60.109:8087/api/v1/repos/vansh/pi-utility-server/actions/runs'
SECRETS=/home/vansh/.secrets/pi-utility-server.env

TOKEN="$(grep '^GITEA_PUSH_TOKEN=' "$SECRETS" | cut -d= -f2)"
if [[ -z "$TOKEN" ]]; then
  echo "pre-push: GITEA_PUSH_TOKEN missing from $SECRETS" >&2
  exit 1
fi

# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^[0-9a-f]{40}$ ]] || continue

  resp="$(curl -s -H "Authorization: token $TOKEN" "${GITEA_API}?sha=${local_sha}&limit=1")"
  conclusion="$(printf '%s' "$resp" | grep -oE '"conclusion":"[^"]*"' | head -1 | cut -d'"' -f4)"

  if [[ "$conclusion" != "success" ]]; then
    echo "pre-push: BLOCKED push to github for ${local_sha}" >&2
    echo "  gitea CI conclusion is '${conclusion:-none}' (expected 'success')." >&2
    echo "  Push to gitea first, wait for CI, then retry github." >&2
    exit 1
  fi
  echo "pre-push: gitea CI green for ${local_sha}"
done

exit 0

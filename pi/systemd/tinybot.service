[Unit]
Description=TinyBot Telegram Assistant (no LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vansh
Group=vansh
WorkingDirectory=/home/vansh/pi4homelab/pi/tinybot/pi
ExecStart=/home/vansh/pi4homelab/pi/tinybot/.venv/bin/python3 tinybot.py
Environment=HOME=/home/vansh
Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictNamespaces=true
ReadWritePaths=/home/vansh/pi4homelab/pi/tinybot/state /tmp/fan_speed_val

[Install]
WantedBy=multi-user.target

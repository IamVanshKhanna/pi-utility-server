[Unit]
Description=TinyBot Telegram Assistant (no LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vansh
Group=vansh
WorkingDirectory=/home/vansh
ExecStart=/home/vansh/bin/tinybot-launch.sh
Environment=HOME=/home/vansh
Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

NoNewPrivileges=true

[Install]
WantedBy=default.target

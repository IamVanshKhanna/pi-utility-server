[Unit]
Description=Homelab Secrets Rotation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vansh
Environment=HOME=/home/vansh
WorkingDirectory=/home/vansh/pi4homelab/pi
ExecStart=/home/vansh/pi4homelab/pi/scripts/secrets-rotation.sh
EnvironmentFile=/home/vansh/pi4homelab/.env

[Install]
WantedBy=multi-user.target
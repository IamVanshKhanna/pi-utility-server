[Unit]
Description=Homelab Secrets Rotation
After=network-online.target
Wants=network-online.target

# Rotates VAULTWARDEN_ADMIN_TOKEN weekly (Sun 03:00 via the .timer) and
# restarts vaultwarden. SAMBA_PASSWORD / PIHOLE_WEBPASSWORD are intentionally
# untouched (would lock out SMB clients / pihole UI). See ADR-010.
# Enable the timer with:
#   systemctl --user enable --now homelab-secrets-rotation.timer

[Service]
Type=oneshot
User=vansh
Group=vansh
WorkingDirectory=/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi
ExecStart="/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi/scripts/secrets-rotation.sh"
Environment=HOME=/home/vansh

NoNewPrivileges=true
# NOTE: no ProtectSystem=strict here (unlike daily-summary) because the script
# must reach the docker socket to recreate vaultwarden; like act-runner.service.

[Install]
WantedBy=default.target

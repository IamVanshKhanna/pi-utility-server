[Unit]
Description=Homelab Secrets Rotation
After=network-online.target
Wants=network-online.target

# NOTE: disabled on autobot-1 as of 2026-08-08 -- pi/scripts/secrets-rotation.sh
# does not exist in the migrated repository (see ADR-010). Re-enable only after
# authoring that script. Enable the timer with:
#   systemctl --user enable --now homelab-secrets-rotation.timer

[Service]
Type=oneshot
User=vansh
Group=vansh
WorkingDirectory=/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi
ExecStart="/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi/scripts/secrets-rotation.sh"
Environment=HOME=/home/vansh

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/nas/02. shared/01. PI Files/01. pi-utility-server /home/vansh/.secrets

[Install]
WantedBy=multi-user.target

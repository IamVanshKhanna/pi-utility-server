[Unit]
Description=Daily Homelab Health Summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vansh
Group=vansh
WorkingDirectory=/home/vansh/pi4homelab/pi
ExecStart=/home/vansh/pi4homelab/pi/scripts/daily-health-summary.sh
Environment=HOME=/home/vansh

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/vansh/pi4homelab /mnt/nas/backup/logs

[Install]
WantedBy=multi-user.target

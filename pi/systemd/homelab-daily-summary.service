[Unit]
Description=Daily Homelab Health Summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vansh
Group=vansh
WorkingDirectory=/home/vansh/homelab-ops-mesh/pi
ExecStart=/home/vansh/homelab-ops-mesh/pi/scripts/daily-health-summary.sh
Environment=HOME=/home/vansh

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/vansh/homelab-ops-mesh /mnt/nas/backup/logs

[Install]
WantedBy=multi-user.target

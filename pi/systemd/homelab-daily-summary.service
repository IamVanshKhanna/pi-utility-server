[Unit]
Description=Daily Homelab Health Summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vansh
Group=vansh
Environment=PI_ENV_FILE=/home/vansh/.secrets/pi-utility-server.env
WorkingDirectory=/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi
ExecStart="/mnt/nas/02. shared/01. PI Files/01. pi-utility-server/pi/scripts/daily-health-summary.sh"
Environment=HOME=/home/vansh

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/nas/backup/logs

[Install]
WantedBy=multi-user.target

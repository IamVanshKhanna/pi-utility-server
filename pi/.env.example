# =============================================================
# homelab-ops-mesh - Environment Variables (Pi node)
# Copy this file: cp .env.example .env
# Then fill in every value before deploying.
# NEVER commit your .env file - it is in .gitignore
# =============================================================

# --- GENERAL --------------------------------------------------
TZ=Australia/Melbourne
PUID=1000
PGID=1000
DATA_DIR=/mnt/nas/shared
BACKUP_DIR=/mnt/nas/backup

# --- DOMAIN ---------------------------------------------------
# Tailscale MagicDNS hostname for the Pi node
DOMAIN=autobot.taila24d04.ts.net

# --- WINDOWS NODE ---------------------------------------------
# Windows Tailscale IP (for Pi→Windows routing: Loki, Alertmanager, Grafana)
WINDOWS_IP=100.64.0.2

# --- TRAEFIK --------------------------------------------------
# Dashboard credentials: generate htpasswd hash and set as TRAEFIK_BASICAUTH
# Example: htpasswd -nb admin yourpassword | sed 's/\$/\$\$/g'
# Then wrap in quotes: TRAEFIK_BASICAUTH="admin:$apr1$..."
TRAEFIK_BASICAUTH=admin:REPLACE_WITH_htpasswd_hash

# --- PIHOLE ---------------------------------------------------
PIHOLE_WEBPASSWORD=changeme_pihole
PIHOLE_DNS1=1.1.1.1
PIHOLE_DNS2=8.8.8.8

# --- MARIADB (Nextcloud database) -----------------------------
MYSQL_ROOT_PASSWORD=changeme_mariadb_root
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme_mariadb_user

# --- NEXTCLOUD ------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=autobot.taila24d04.ts.net

# --- VAULTWARDEN ----------------------------------------------
# Generate token with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=changeme_random_64char

# --- SAMBA ----------------------------------------------------
# Required: set a strong password for Samba user 'vansh'
SAMBA_PASSWORD=

# --- SYNCTHING ------------------------------------------------
# No credentials needed -- set password via Web UI at first login
# Access at http://pi-ip:8384

# --- REDIS (Apps stack) ----------------------------------------
REDIS_APPS_PASSWORD=changeme_redis_apps

# --- UPTIME KUMA ----------------------------------------------
# No credentials needed -- set admin account on first visit
# Access at http://pi-ip:3001

# --- TELEGRAM (TinyBot alerts) --------------------------------
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here
# Comma-separated list of Telegram chat IDs allowed to control the bot
ADMIN_CHAT_IDS=your_chat_id_here

# --- CROWDSEC -------------------------------------------------
# Generate API key: cscli bouncers add my-bouncer
CROWDSEC_API_KEY=changeme_crowdsec_api_key

# --- CROWDSEC RELAY ------------------------------------------
# Generate with: openssl rand -hex 32
RELAY_TOKEN=changeme_relay_token

# --- HEADSCALE ------------------------------------------------
# Self-hosted Tailscale control server
# Generate API key: docker exec headscale headscale apikeys create
HEADSCALE_API_KEY=changeme_headscale_api_key

# --- GITEA ----------------------------------------------------
# Self-hosted Git server (CI runner is systemd-hosted, not Docker)
# Generate runner token: docker exec gitea gitea actions generate-runner-token
# Only needed for initial runner registration, not at deploy time
GITEA_RUNNER_TOKEN=changeme_gitea_runner_token

# --- BACKUP (Restic) -------------------------------------------
# Local backup to /mnt/nas/backup/restic-repo
# For B2, set RESTIC_REPOSITORY=b2:bucketname:path and add B2_ACCOUNT_ID / B2_ACCOUNT_KEY
RESTIC_PASSWORD=changeme_restic
RESTIC_REPOSITORY=/mnt/nas/backup/restic-repo
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

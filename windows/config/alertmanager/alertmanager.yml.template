# alertmanager.yml — Alertmanager config template
# Copy this template: cp alertmanager.yml.template alertmanager.yml
# NEVER commit the real alertmanager.yml (it is in .gitignore)
# Token + chat_id are substituted at runtime by entrypoint.sh
global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'job']
  group_wait: 30s
  group_interval: 2m
  repeat_interval: 2h
  receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
    - api_url: "https://api.telegram.org"
      bot_token: "${TELEGRAM_BOT_TOKEN}"
      chat_id: ${TELEGRAM_CHAT_ID}
      parse_mode: "HTML"
      send_resolved: true
      message: |
        {{ if eq .Status "firing" }}🚨<b>{{ .GroupLabels.alertname }}</b>{{ else }}✅ Resolved: <b>{{ .GroupLabels.alertname }}</b>{{ end }}
        {{ with .Annotations.summary }}{{ . }}
        {{ end }}
        {{ $count := len .Alerts.Firing }}
        {{ if gt $count 1 -}}
        <i>Affects {{ $count }} instances</i>
        {{ end -}}

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']

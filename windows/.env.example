# Windows Homelab - Environment Variables
# Copy this file to .env and fill in values
# cp .env.example .env

# --- GENERAL --------------------------------------------------
TZ=Australia/Melbourne
# Tailscale MagicDNS domain (used by Infisical SITE_URL)
DOMAIN=autobot.taila24d04.ts.net

# --- GRAFANA ---------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana
GF_SERVER_ROOT_URL=https://autobot.taila24d04.ts.net/grafana/

# --- AUTHELIA ---------------------------------------------------
AUTHELIA_JWT_SECRET=changeme_32char_hex
AUTHELIA_SESSION_SECRET=changeme_32char_hex
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme_32char_hex
AUTHELIA_REDIS_PASSWORD=changeme_16char_hex

# --- INFISICAL --------------------------------------------------
INFISICAL_AUTH_SECRET=changeme_32char_hex
INFISICAL_ENCRYPTION_KEY=changeme_32char_hex
INFISICAL_REDIS_PASSWORD=changeme_16char_hex
INFISICAL_POSTGRES_PASSWORD=changeme_16char_hex

# --- TELEGRAM (Alertmanager) ------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
